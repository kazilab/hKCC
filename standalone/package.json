{
  "name": "hkcc-standalone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone single-file HTML build of the hKCC atlas (read-only, no backend).",
  "scripts": {
    "export-data": "python scripts/export_data.py",
    "predev": "python scripts/export_data.py",
    "dev": "vite",
    "prebuild": "python scripts/export_data.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
